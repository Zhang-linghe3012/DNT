# ===================== SUPABASE =====================
# Lấy giá trị từ Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key - CHỈ dùng server-side, KHÔNG bao giờ expose ra client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===================== CHATBOT AI =====================
# Sử dụng Google Gemini SDK (@google/generative-ai) với model gemini-1.5-flash.
# Key chỉ dùng server-side qua /api/chat, KHÔNG lộ ra client.

GEMINI_API_KEY=your-google-gemini-api-key
# Fallback (OpenAI-compatible) nếu chưa có GEMINI_API_KEY
CHATBOT_API_KEY=your-openai-compatible-api-key
CHATBOT_API_BASE_URL=https://api.openai.com/v1
CHATBOT_API_MODEL=gpt-4o-mini

# ===================== SINH ẢNH (/api/image) =====================
# Provider mặc định: Gemini (GEMINI_API_KEY ở trên). Để dùng DALL-E 3:
OPENAI_API_KEY=your-openai-api-key
OPENAI_IMAGE_MODEL=dall-e-3
# Model Gemini dùng cho sinh ảnh:
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ===================== SINH VIDEO (MÔ PHỎNG DA) =====================
# Dùng GoogleGenAI (Veo) để tạo video mô phỏng tiến trình phục hồi da.
# Model Veo mặc định; có thể đổi sang "veo-3.0-generate-001", "gemini-omni-flash-generate-001",...
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-001